# openkeep Produktion (openkeep.de) – Vorlage für den Dokploy Environment-Tab
#
# NICHT als .env committen! Werte in Dokploy unter
# Projekt -> Compose-Service -> Environment eintragen.
#
# Secrets generieren:  openssl rand -base64 32

# --- Datenbank & Objektspeicher (interne Dienste, nie öffentlich) ---
POSTGRES_PASSWORD=
MINIO_ROOT_USER=openkeep-admin
MINIO_ROOT_PASSWORD=

# --- Auth (jeweils min. 32 Zeichen) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Initialer Owner-Account ---
OWNER_EMAIL=marcel.pochert@berenberg.de
OWNER_PASSWORD=
OWNER_NAME=Marcel

# --- Mistral (einziger KI-/OCR-Provider, kein lokaler Fallback) ---
MISTRAL_API_KEY=

# --- Optional (Defaults siehe docker-compose.prod.yml) ---
# IMAGE_TAG=latest            # oder ein Commit-SHA für Pinning/Rollback
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_EMBEDDING_MODEL=mistral-embed
# LOG_LEVEL=info
